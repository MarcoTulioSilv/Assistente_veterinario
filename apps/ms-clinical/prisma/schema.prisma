// ══════════════════════════════════════════════════════════════════
// MS3 — Clinical Service
// Marco M2 · Set/2026 · Dev 1 (Marco Túlio)
//
// Atendimento clínico / ficha clínica (RF-ATD-001 a 011). Exames
// (RF-EXM) e vacinação (RF-VAC) entram nas Sprints 6 e 7.
//
// Referências a outros microsserviços (proprietário, propriedade,
// animal, veterinário do MS1; produto do MS2) são UUID sem FK:
// database-per-service (ADR-001 §5.1) — não existe join entre bancos,
// a integridade é validada na borda, não pelo Postgres.
// ══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-clinical"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_CLINICAL")
}

/// RF-ATD-002
enum AppointmentType {
  clinico_geral
  reproducao
  odontologico
  locomotor
  cirurgia
}

enum AppointmentStatus {
  draft
  finished
  cancelled
}

/// RF-ATD-005
enum AdministrationRoute {
  oral
  intravenosa
  intramuscular
  subcutanea
  topica
  intrauterina
  outra
}

/// RF-ATD-006
enum AppointmentItemKind {
  product
  procedure
}

model Appointment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // ─── Referências ao MS1 (sem FK — ver cabeçalho) ───────────────
  ownerId        String @map("owner_id") @db.Uuid
  propertyId     String @map("property_id") @db.Uuid
  animalId       String @map("animal_id") @db.Uuid
  veterinarianId String @map("veterinarian_id") @db.Uuid

  type   AppointmentType
  status AppointmentStatus @default(draft)

  /// RF-ATD-004: animal temporariamente em local diferente da propriedade de registro
  animalLocation String?  @map("animal_location") @db.Text
  performedAt    DateTime @map("performed_at") @db.Timestamptz

  // ─── RF-ATD-006: orçamento ─────────────────────────────────────
  // Centavos, INTEGER (ADR-001 §5.6). A taxa de km fica gravada na linha
  // em vez de lida de uma config global na exibição: quando a taxa mudar,
  // o orçamento já fechado não pode mudar junto.
  laborCents            Int     @default(0) @map("labor_cents")
  displacementKm        Decimal @default(0) @map("displacement_km") @db.Decimal(10, 2)
  displacementRateCents Int     @default(0) @map("displacement_rate_cents")

  /// Soma dos itens + mão de obra + deslocamento, congelada em finish().
  /// Não é coluna GENERATED (ao contrário de products.sale_price_cents):
  /// depende das linhas filhas, e uma generated column só enxerga a
  /// própria linha. Congelar também é requisito: é o valor que vai no
  /// evento do broker e na pendência financeira (RF-ATD-008).
  totalCents Int @default(0) @map("total_cents")

  // Situação de pagamento não mora aqui: o ADR-001 §5.3 dá o RN-002 ao
  // Reporting, que abre a pendência ao consumir `appointment.done`.
  // Ver apps/ms-reporting/prisma/schema.prisma → FinancialRecord.
  finishedAt DateTime? @map("finished_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  medicalRecord MedicalRecord?
  items         AppointmentItem[]
  prescriptions Prescription[]

  @@index([tenantId])
  @@index([animalId])
  @@index([ownerId])
  @@index([performedAt])
  @@index([status])
  @@map("appointments")
}

/// RF-ATD-001: ficha clínica.
model MedicalRecord {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @unique @map("appointment_id") @db.Uuid

  /// Campos narrativos nomeados no RF-ATD-001 ficam em coluna — são os
  /// mesmos em todo tipo de atendimento e aparecem no histórico do animal
  /// (RF-ATD-011) sem precisar abrir o JSON.
  anamnesis String? @db.Text
  diagnosis String? @db.Text
  treatment String? @db.Text
  prognosis String? @db.Text
  referral  String? @db.Text

  /// Já o exame físico é JSONB (ADR-001 §4): os sinais vitais variam e os
  /// exames especiais mudam por tipo de atendimento — os de reprodução não
  /// são os de locomotor. Em coluna viraria dezenas de campos nulos; a
  /// validação da forma fica no Zod, por tipo, não no banco.
  generalExam  Json? @map("general_exam") @db.JsonB
  specialExams Json? @map("special_exams") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("medical_records")
}

/// RF-ATD-006/007: linha do orçamento.
model AppointmentItem {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid

  kind AppointmentItemKind

  /// Só em `product`: produto no MS2 (sem FK — ver cabeçalho). É este campo
  /// que vira `consumedItems` no evento de baixa de estoque (RN-003).
  productId String? @map("product_id") @db.Uuid

  /// Nome e preço congelados no atendimento: o produto pode ser renomeado,
  /// ter o preço alterado ou ser removido depois, e a ficha tem valor legal.
  description    String  @db.VarChar(255)
  quantity       Decimal @db.Decimal(10, 3)
  unitPriceCents Int     @map("unit_price_cents")
  totalCents     Int     @map("total_cents")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appointmentId])
  @@index([productId])
  @@map("appointment_items")
}

// ═══ Exames (RF-EXM-001 a 006, Sprint 6) ══════════════════════════
// Status e laudo são do PEDIDO inteiro (decisão do Marco, 01/10/2026),
// por isso não existe status por animal.

/// RF-EXM-004, com a coleta opcional: draft → requested → [collected] →
/// in_analysis → result_available. Só avança por ação real.
enum ExamStatus {
  draft
  requested
  collected
  in_analysis
  result_available
}

/// Catálogo da clínica. Começa VAZIO: nada é imposto, uma clínica pode
/// prestar um serviço só. As sugestões (Mormo, AIE) vivem em shared-types e
/// só entram aqui quando o veterinário escolhe uma.
model ExamType {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  name String @db.VarChar(255)

  /// Preço do procedimento POR ANIMAL, sugerido no pedido (RF-EXM-006).
  defaultPriceCents Int @default(0) @map("default_price_cents")

  /// O "tempo previamente cadastrado" do RF-EXM-004. Nulo = sem data
  /// prevista e sem lembrete.
  expectedTurnaroundDays Int? @map("expected_turnaround_days")

  /// RF-EXM-002: descritores dos campos do protocolo
  /// ({key, label, type, required, options?}). Validados no service.
  protocolFields Json @default("[]") @map("protocol_fields") @db.JsonB

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  requests ExamRequest[]

  @@index([tenantId])
  @@map("exam_types")
}

/// RF-EXM-001: o pedido de exame.
model ExamRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // ─── Referências ao MS1 (sem FK — ver cabeçalho) ───────────────
  ownerId        String @map("owner_id") @db.Uuid
  propertyId     String @map("property_id") @db.Uuid
  veterinarianId String @map("veterinarian_id") @db.Uuid

  /// FK local: o catálogo mora no mesmo banco. Restrict — tipo só sai por
  /// soft delete, nunca fisicamente.
  examTypeId String @map("exam_type_id") @db.Uuid

  /// Cópias do tipo no momento do pedido. O veterinário pode renomear o tipo
  /// ou mudar os campos do protocolo depois; o pedido (e o laudo, que tem
  /// valor legal) precisa continuar se explicando sozinho.
  examTypeName   String @map("exam_type_name") @db.VarChar(255)
  protocolFields Json   @default("[]") @map("protocol_fields") @db.JsonB
  protocolData   Json   @default("{}") @map("protocol_data") @db.JsonB

  /// Só preenchidos se o VETERINÁRIO colheu — a coleta é opcional (outra
  /// pessoa pode colher a amostra).
  material    String?   @db.VarChar(255)
  collectedAt DateTime? @map("collected_at") @db.Timestamptz

  /// O "ou lote" do RF-EXM-001: grupo de animais sem identificação
  /// individual. O pedido pode ter animais, lote, ou os dois.
  lotDescription String? @map("lot_description") @db.VarChar(255)
  lotSize        Int?    @map("lot_size")

  status ExamStatus @default(draft)

  /// collectedAt + prazo do tipo. Base do lembrete D-1/no dia.
  expectedResultAt DateTime? @map("expected_result_at") @db.Timestamptz

  /// RF-EXM-005 — só a URL; o arquivo sobe pelo endpoint de upload.
  resultFileUrl    String?   @map("result_file_url") @db.Text
  resultUploadedAt DateTime? @map("result_uploaded_at") @db.Timestamptz

  // ─── RF-EXM-006: custo ─────────────────────────────────────────
  // Centavos, INTEGER (ADR-001 §5.6). O que entra na conta depende de quem
  // paga o laboratório e de quem coletou — regra no ExamService.
  /// O cliente paga o laboratório direto (decisão dos stakeholders).
  paidDirectlyByClient  Boolean   @default(false) @map("paid_directly_by_client")
  unitPriceCents        Int       @default(0) @map("unit_price_cents")
  laborCents            Int       @default(0) @map("labor_cents")
  displacementKm        Decimal   @default(0) @map("displacement_km") @db.Decimal(10, 2)
  displacementRateCents Int       @default(0) @map("displacement_rate_cents")
  /// Congelado quando a cobrança fecha (primeira saída de `requested`).
  totalCents            Int       @default(0) @map("total_cents")
  /// Nulo = cobrança ainda aberta. Preenchido mesmo se o total for 0 —
  /// marca que a decisão de cobrança já foi tomada.
  chargedAt             DateTime? @map("charged_at") @db.Timestamptz

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  examType ExamType            @relation(fields: [examTypeId], references: [id], onDelete: Restrict)
  animals  ExamRequestAnimal[]
  items    ExamRequestItem[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([status])
  @@index([expectedResultAt])
  @@map("exam_requests")
}

/// RF-EXM-003: animais do pedido. Sem status próprio (decisão do Marco).
model ExamRequestAnimal {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  examRequestId String @map("exam_request_id") @db.Uuid

  /// Animal no MS1 — sem FK.
  animalId String @map("animal_id") @db.Uuid

  examRequest ExamRequest @relation(fields: [examRequestId], references: [id], onDelete: Cascade)

  @@unique([examRequestId, animalId])
  @@index([tenantId])
  @@index([animalId])
  @@map("exam_request_animals")
}

/// RF-EXM-006: insumo da coleta — sempre dá baixa no estoque; só é cobrado
/// quando o cliente paga o laboratório direto.
model ExamRequestItem {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  examRequestId String @map("exam_request_id") @db.Uuid

  /// Produto no MS2 (sem FK). Vira `consumedItems` no exam.collected.
  productId      String  @map("product_id") @db.Uuid
  description    String  @db.VarChar(255)
  quantity       Decimal @db.Decimal(10, 3)
  /// Preço congelado, como nos itens do atendimento.
  unitPriceCents Int     @map("unit_price_cents")
  totalCents     Int     @map("total_cents")

  examRequest ExamRequest @relation(fields: [examRequestId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([examRequestId])
  @@map("exam_request_items")
}

/// Padrão Outbox (ADR-001 §6.2, ADR-002).
///
/// O evento é gravado AQUI, na MESMA transação que a mudança de negócio
/// que o originou — então ou os dois acontecem, ou nenhum. Um relay
/// separado lê esta tabela e publica no broker depois do commit.
///
/// Sem isso, `finish()` commitaria o atendimento no Postgres e publicaria
/// no Redis em seguida, sem atomicidade: Redis fora do ar nesse instante
/// = baixa de estoque e pendência financeira perdidas em silêncio.
model OutboxEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Nome do evento (EVENTS.* de shared-types) — vira o nome do job.
  eventName String @map("event_name") @db.VarChar(100)

  /// Envelope DomainEvent completo, serializado.
  payload Json @db.JsonB

  /// Chave do envelope. O relay a usa como jobId no BullMQ, então
  /// republicar a mesma linha (crash entre publicar e marcar) não
  /// duplica o job — ADR-001 §5.4.
  idempotencyKey String @unique @map("idempotency_key") @db.Uuid

  /// NULL = ainda não publicado. É a fila do relay.
  publishedAt DateTime? @map("published_at") @db.Timestamptz

  attempts  Int     @default(0)
  lastError String? @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// Índice da query do relay: pendentes, mais antigo primeiro.
  @@index([publishedAt, createdAt])
  @@index([tenantId])
  @@map("outbox_events")
}

/// RF-ATD-005: prescrição / protocolo de tratamento.
model Prescription {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  appointmentId String @map("appointment_id") @db.Uuid

  /// A "flag origem" do RF-ATD-005: preenchido = saiu do estoque (MS2);
  /// null = receita externa, o tutor compra por fora.
  productId       String?             @map("product_id") @db.Uuid
  medicationName  String              @map("medication_name") @db.VarChar(255)
  dose            String              @db.VarChar(100)
  route           AdministrationRoute
  /// Texto livre — "a cada 12h por 5 dias".
  schedule        String              @db.VarChar(255)
  applicationSite String?             @map("application_site") @db.VarChar(255)
  notes           String?             @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appointmentId])
  @@map("prescriptions")
}
