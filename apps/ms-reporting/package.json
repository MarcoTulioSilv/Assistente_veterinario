{
  "name": "@quironequine/ms-reporting",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "dotenv -e ../../.env -- node dist/index.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "clean": "rimraf dist .turbo coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "@quironequine/shared-middlewares": "*",
    "@quironequine/shared-types": "*",
    "bullmq": "^5.34.0",
    "express": "^4.21.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
