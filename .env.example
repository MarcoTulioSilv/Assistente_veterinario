# ══════════════════════════════════════════════════════════════════
# VetEquine — Variáveis de Ambiente
# Copie para .env e preencha. NUNCA commite o arquivo .env
# ══════════════════════════════════════════════════════════════════

NODE_ENV=development
LOG_LEVEL=debug

# ─── JWT / Auth ───────────────────────────────────────────────────
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-secret-forte-de-no-minimo-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Bancos de dados (um por microsserviço) ───────────────────────
DATABASE_URL_IDENTITY=postgresql://vetequine:vetequine@localhost:5432/identity?schema=public
DATABASE_URL_INVENTORY=postgresql://vetequine:vetequine@localhost:5433/inventory?schema=public
DATABASE_URL_CLINICAL=postgresql://vetequine:vetequine@localhost:5434/clinical?schema=public
DATABASE_URL_SCHEDULING=postgresql://vetequine:vetequine@localhost:5435/scheduling?schema=public
DATABASE_URL_NOTIFICATION=postgresql://vetequine:vetequine@localhost:5436/notification?schema=public
DATABASE_URL_REPORTING=postgresql://vetequine:vetequine@localhost:5437/reporting?schema=public
DATABASE_URL_AIVOICE=postgresql://vetequine:vetequine@localhost:5438/aivoice?schema=public

# ─── Redis / Message Broker ───────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_PREFIX=vetequine

# ─── Portas dos serviços ──────────────────────────────────────────
PORT_BFF=3000
PORT_MS_IDENTITY=3001
PORT_MS_INVENTORY=3002
PORT_MS_CLINICAL=3003
PORT_MS_SCHEDULING=3004
PORT_MS_NOTIFICATION=3005
PORT_MS_REPORTING=3006
PORT_MS_AIVOICE=3007

# ─── URLs internas (usadas pelo BFF) ──────────────────────────────
MS_IDENTITY_URL=http://localhost:3001
MS_INVENTORY_URL=http://localhost:3002
MS_CLINICAL_URL=http://localhost:3003
MS_SCHEDULING_URL=http://localhost:3004
MS_NOTIFICATION_URL=http://localhost:3005
MS_REPORTING_URL=http://localhost:3006
MS_AIVOICE_URL=http://localhost:3007

# ─── PWA ──────────────────────────────────────────────────────────
NEXT_PUBLIC_BFF_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_NAME=VetEquine

# ─── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=100
RATE_LIMIT_MAX_PER_TENANT=500

# ─── APIs externas (M2+) ──────────────────────────────────────────
# Custos por conta dos Contratantes (Cláusula 2.2 do contrato)
GOOGLE_MAPS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Storage (M2+) ────────────────────────────────────────────────
S3_ENDPOINT=
S3_BUCKET=vetequine-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ─── Observabilidade (M3+) ────────────────────────────────────────
SENTRY_DSN=
