# ══════════════════════════════════════════════════════════════════
# VetEquine — Variáveis de Ambiente (STAGING/PRODUÇÃO na VM Oracle)
#
# Copie para .env.production NA PRÓPRIA VM (nunca no seu computador,
# nunca no Git) e preencha os valores reais. Ver
# scripts/deploy/07-env-production-setup.sh — ele gera o JWT_SECRET
# forte e faz essa cópia por você.
#
# Diferenças em relação ao .env.example de desenvolvimento:
#   - hosts de banco/redis são os nomes dos serviços do
#     docker-compose.prod.yml (db-identity, db-inventory, redis),
#     não localhost — os containers falam entre si pela rede Docker
#     interna, não pela porta publicada no host.
#   - senhas de banco são geradas de verdade, não "vetequine"/
#     "app_dev_password" (só servem pra dev local).
#   - PUBLIC_BFF_URL/NEXT_PUBLIC_APP_URL apontam pro domínio real,
#     não localhost.
#   - só identity/inventory — MS3 a MS7 ainda não existem
#     (CLAUDE.md), não faz sentido reservar URL/porta pra eles aqui.
# ══════════════════════════════════════════════════════════════════

NODE_ENV=production
LOG_LEVEL=info

# ─── JWT / Auth ───────────────────────────────────────────────────
# Gerado automaticamente pelo script 07 (openssl rand -base64 48) —
# não reutilize o mesmo valor do .env de dev.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Bancos de dados ────────────────────────────────────────────────
# Troque <SENHA_SUPERUSER>/<SENHA_APP> por valores gerados de verdade
# (ex.: openssl rand -base64 24) — nunca "vetequine"/"app_dev_password".
DATABASE_URL_IDENTITY=postgresql://vetequine:<SENHA_SUPERUSER>@db-identity:5432/identity?schema=public
DATABASE_URL_IDENTITY_APP=postgresql://vetequine_app:<SENHA_APP>@db-identity:5432/identity?schema=public
DATABASE_URL_INVENTORY=postgresql://vetequine:<SENHA_SUPERUSER>@db-inventory:5432/inventory?schema=public
DATABASE_URL_INVENTORY_APP=postgresql://vetequine_app:<SENHA_APP>@db-inventory:5432/inventory?schema=public

# Senhas do Postgres em si (usadas pelo docker-compose.prod.yml pra
# inicializar os containers — precisam bater com as URLs acima).
POSTGRES_SUPERUSER_PASSWORD=<SENHA_SUPERUSER>

# ─── Redis / Message Broker ───────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_QUEUE_PREFIX=vetequine

# ─── Portas dos serviços (internas — Caddy expõe só 80/443) ───────
PORT_BFF=3000
PORT_MS_IDENTITY=3001
PORT_MS_INVENTORY=3002

# ─── URLs internas (usadas pelo BFF, rede Docker interna) ─────────
MS_IDENTITY_URL=http://ms-identity:3001
MS_INVENTORY_URL=http://ms-inventory:3002

# ─── PWA / CORS ───────────────────────────────────────────────────
# Domínio real do Cloudflare Pages (script 06) — sem barra no final.
# apps/bff/src/index.ts usa isto pra liberar CORS (não precisa mudar
# código, só esta env var).
NEXT_PUBLIC_APP_URL=https://app.SEUDOMINIO.com.br

# Domínio real da API (script 03, atrás do Caddy/TLS) — usado só pra
# montar a URL absoluta devolvida pelo upload de arquivo
# (LocalStorageAdapter). Sem '/api/v1' no final.
PUBLIC_BFF_URL=https://api.SEUDOMINIO.com.br

# ─── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=100
RATE_LIMIT_MAX_PER_TENANT=500

# ─── APIs externas (deixar em branco por enquanto — M2+) ──────────
GOOGLE_MAPS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ─── TLS (Caddy) ──────────────────────────────────────────────────
# E-mail usado pelo Let's Encrypt pra avisos de expiração de certificado.
CADDY_ACME_EMAIL=
